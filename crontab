# Portfolio-Lab Crontab — fallback/standalone mode (all jobs now in Hermes cron)
# SWITCHED TO HERMES CRON 2026-05-17 — 10 jobs registered via cronjob tool.
# This file is kept as documentation + fallback only.
#
# To activate fallback (switch FROM Hermes cron TO system cron):
#   1. hermes cron pause <job_id>  (for each portfolio-lab job)
#   2. crontab /root/projects/portfolio-lab/crontab
#
# To switch back:
#   1. crontab -r
#   2. hermes cron resume <job_id>  (for each portfolio-lab job)
#
# All jobs call the Makefile, which updates data/cron_status.json
# for the dashboard health panel.

# Data pipeline — hourly at :05
5 * * * * export PATH="$HOME/.bun/bin:$PATH" && CRON_BACKEND=crontab make -C /root/projects/portfolio-lab data >> /root/projects/portfolio-lab/data/cron.log 2>&1

# Dashboard — every 30 minutes at :07 and :37
7,37 * * * * CRON_BACKEND=crontab make -C /root/projects/portfolio-lab dashboard >> /root/projects/portfolio-lab/data/dashboard.log 2>&1

