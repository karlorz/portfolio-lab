# Portfolio-Lab Environment Configuration
# Copy to .env and adjust: cp .env.example .env
# Values below mirror source defaults where defaults exist. Secrets are blank.

# ── Runtime Paths ────────────────────────────────────────────────────
# Project and data locations used by scripts, cron wrappers, and Python modules.
PORTFOLIO_LAB_PROJECT_DIR=/root/projects/portfolio-lab
PORTFOLIO_LAB_APP_DIR=/root/projects/portfolio-lab
PUBLIC_DATA_DIR=/root/projects/portfolio-lab/public/data
LOCK_DIR=/tmp/portfolio-lab-locks
WIKI_DIR=/root/wiki
WORK_DIR=/root/wiki/projects/portfolio-lab/work

# ── ML Features ──────────────────────────────────────────────────────
# Keep disabled for normal development; enable only for explicit ML runs.
PORTFOLIO_LAB_ENABLE_ML=0
INFERENCE_TIME_PLANNING=0

# ── Lab App Deployment ───────────────────────────────────────────────
# Host-native LXC deployment defaults. DNS is managed outside this repo.
PORTFOLIO_LAB_MODE=lab
PORTFOLIO_LAB_SITE_ADDRESS=lab.karldigi.dev
PORTFOLIO_LAB_WEB_ROOT=/var/www/portfolio-lab
PORTFOLIO_LAB_PUBLIC_ROOT=/var/www/portfolio-lab
PORTFOLIO_LAB_TASKER_UPSTREAM=pipeline:8000
TASKER_HOST=127.0.0.1
TASKER_PORT=8000
TASKER_SERVICE_NAME=portfolio-lab-tasker
TASKER_ENTRYPOINT_MODE=tasker
TASKER_ADMIN_TOKEN=
TASKER_DISABLE_SCHEDULER=0
TASKER_INCLUDE_HERMES_AUDIT=0
CADDY_CONFIG=/etc/caddy/Caddyfile
CADDY_SERVICE_NAME=caddy
UPDATE_COMMAND_PATH=/usr/local/bin/portfolio-lab-update

# ── Broker / Alpaca ──────────────────────────────────────────────────
# ALPACA_API_SECRET is canonical. ALPACA_SECRET_KEY remains as a deprecated
# compatibility alias for older options code paths.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_MARKET_SESSION_STATE=
BROKER_MARKET_SESSION_STATE=
BROKER_MAX_QUOTE_AGE_SECONDS=900
BROKER_CIRCUIT_FAIL_MAX=3
BROKER_CIRCUIT_RESET_TIMEOUT=60

# ── External APIs ────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FRED_API_KEY=
API_RATE_LIMIT_RPM=60
API_RETRY_MAX=3
API_RETRY_BACKOFF=1.0

# ── Logging / Cron / Alerts ──────────────────────────────────────────
LOG_LEVEL=INFO
JSON_LOGS=0
CRON_RUN_ID=
CRON_BACKEND=hermes
CRON_FIELD_PREVIEW_CHARS=4096
# Never-run / recovery SLI for tasker cron honesty (src/monitor/hermes_cron.py)
PORTFOLIO_LAB_CRON_RECOVERY_GRACE_SECONDS=180
PORTFOLIO_LAB_CRON_RECOVERY_MAX_AGE_HOURS=6
HERMES_HOME=/root/.hermes
HERMES_CRON_JOBS_PATH=
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300
# Unresolved WARN/HALT incidents write an incident-owned kill_switch.json after
# N alert observations: N=warning, 2N=restrict, 3N=halt. Set enabled=0 to disable.
INCIDENT_KILL_SWITCH_ESCALATION_ENABLED=1
INCIDENT_KILL_SWITCH_ESCALATION_CYCLES=3

# ── Strategy Runtime ─────────────────────────────────────────────────
ALPHALAB_MODE=paper
VOL_TARGET=0.15
MAX_DEVIATION=0.10
MIN_WEIGHT=0.05
REBALANCE_FREQ=21
RISK_FREE_RATE=4.5

# Regime allocation code default is off; cron strategy-eval wrapper exports
# REGIME_ALLOC_ENABLED=1 for scheduled evaluation when desired.
REGIME_ALLOC_ENABLED=0
REGIME_ALLOC_OVERRIDE=

# ── Regime / VIX Thresholds ──────────────────────────────────────────
VIX_CRISIS_THRESHOLD=25.0
VIX_VOL_SPIKE_THRESHOLD=20.0
VIX_LOW_VOL_THRESHOLD=15.0
# Optional prices JSON path for VIX dual-threshold historical backtest
VIX_DUAL_HISTORICAL_PRICES_JSON=
# Max weekdays of yield-curve lag before dashboard marks stale (generator)
YIELD_CURVE_MAX_STALE_WEEKDAYS=5
REGIME_VOL_SCALING_CRISIS=0.5
REGIME_VOL_SCALING_HIGH_VOL=0.75
REGIME_VOL_SCALING_NORMAL=1.0
REGIME_VOL_SCALING_LOW_VOL=0.5
REGIME_VOL_SCALING_RECOVERY=0.8
REGIME_VOL_LOOKBACK_CRISIS=252
REGIME_VOL_LOOKBACK_HIGH_VOL=126
REGIME_VOL_LOOKBACK_NORMAL=63
REGIME_VOL_LOOKBACK_LOW_VOL=20
REGIME_VOL_LOOKBACK_RECOVERY=63

# ── Ensemble Voting ──────────────────────────────────────────────────
ENSEMBLE_WEIGHTS_FILE=/root/projects/portfolio-lab/data/ensemble_weights.json
ENSEMBLE_CONDITIONAL_WEIGHTS_FILE=/root/projects/portfolio-lab/data/regime_conditional_weights.json
ENSEMBLE_CONSENSUS_THRESHOLD=0.6666666666666666
ENSEMBLE_CRISIS_VOL_THRESHOLD=0.30
ENSEMBLE_CRISIS_DRAWDOWN_THRESHOLD=-0.10
ENSEMBLE_HIGH_VOL_VOL_THRESHOLD=0.20
ENSEMBLE_HIGH_VOL_DRAWDOWN_THRESHOLD=-0.05
ENSEMBLE_LOW_VOL_VOL_THRESHOLD=0.12
ENSEMBLE_LOW_VOL_MOM_THRESHOLD=0.01
ENSEMBLE_RECOVERY_DRAWDOWN_THRESHOLD=-0.03
ENSEMBLE_RECOVERY_MOM_THRESHOLD=0.02
ENSEMBLE_BANDIT_MAX_BLEND=0.7
ENSEMBLE_BANDIT_WARMUP_DAYS=252
# Skip bandit reward updates when |daily return| is below this noise floor
ENSEMBLE_BANDIT_REWARD_NOISE_FLOOR=1e-6
ENSEMBLE_DIVERSITY_FLOOR=0.05
ENSEMBLE_USE_IC_WEIGHTS=0
ENSEMBLE_DISABLE_REGIME_WEIGHTS=0
ENSEMBLE_USE_MDP_CONSTRAINT=0
ENSEMBLE_IC_WEIGHT_BLEND_ALPHA=0.3
ENSEMBLE_EXPLORATION_EPSILON=0.05
ENSEMBLE_EXPLORATION_ALPHA=10.0

# ── Paper Trading / Graduation / Kill Switch ─────────────────────────
PAPER_INITIAL_CAPITAL=100000
PAPER_MAX_POSITION_PCT=0.5
PAPER_MAX_DRAWDOWN_PCT=0.15
PAPER_REBALANCE_THRESHOLD=0.10
PAPER_PERIODIC_REBALANCE_DAYS=30
PAPER_PERIODIC_REBALANCE_DRIFT=0.02
PAPER_VOLATILITY_TARGET=0.12
MAX_PERFORMANCE_ENTRIES=5000
KILL_WARNING_DRAWDOWN_PCT=0.10
KILL_RESTRICT_DRAWDOWN_PCT=0.15
KILL_HALT_DRAWDOWN_PCT=0.20
KILL_LIQUIDATE_DRAWDOWN_PCT=0.25
KILL_EXTREME_CVAR_RATIO=3.0
GRADUATION_MIN_DAYS=63
GRADUATION_MIN_TRADING_DAYS=63
GRADUATION_MIN_SHARPE=0.50
GRADUATION_MAX_DD=0.15
GRADUATION_MAX_DRAWDOWN=0.25
GRADUATION_MIN_WIN_RATE=0.40
GRADUATION_MAX_REALISTIC_SHARPE=3.0
GRADUATION_MIN_DSR=0.50
GRADUATION_HEALTH_CHECKS=30
GRADUATION_MIN_TCA_ORDERS=10
GRADUATION_CIRCUIT_BREAKER=3
GRADUATION_REGIME_COVERAGE=2
GRADUATION_SIGNAL_DIVERSITY=4
GRADUATION_SHARPE_CI_LOWER=0.30
GRADUATION_PERFORMANCE_LOG_TAIL_LINES=500
GRADUATION_ORDER_LOG_TAIL_LINES=1000
GRADUATION_REGIME_LOG_TAIL_LINES=1000
PROMOTION_MIN_SHARPE_DELTA=0.02
PROMOTION_MAX_DD_WORSE_PCT=2.0
PROMOTION_MAX_CVAR_WORSE=0.05
PROMOTION_MAX_TURNOVER=1.5
PROMOTION_REQUIRE_WFE=0

# ── Monitoring / Health ──────────────────────────────────────────────
HEALTH_CHECK_PATH=/root/projects/portfolio-lab/data/health.json
HEALTH_OPS_PATH=
PORTFOLIO_LAB_LIVE_PUBLIC_DATA_DIR=/var/www/portfolio-lab/data
PORTFOLIO_LAB_ALT_DATA_AUTO_PROJECT=1
# Batch HP: under pytest, multi-dest writers skip production private/public SSOT
# unless this is 1 (opt-in live write for intentional integration tests only).
PORTFOLIO_LAB_ALLOW_LIVE_PUBLIC=0
# Batch EE: pending-artifact dual-signal SLI age window (hours)
PORTFOLIO_LAB_PENDING_ARTIFACT_MAX_AGE_HOURS=192
IC_MIN_OBS_FOR_STATUS=20
SIGNAL_RECOVERY_MIN_UNAVAILABLE=5
SIGNAL_RECOVERY_MIN_HOURS=2
FREEZE_MANIFEST_PATH=/root/projects/portfolio-lab/data/freeze_manifest.json
DECISION_REGISTRY_DB=/root/projects/portfolio-lab/data/decision_registry.db
DECISION_REGISTRY_RECORD_BACKTEST=1
SIGNAL_STALENESS_TTL_HOURS=4
STALENESS_DECAY_TAU_HOURS=2.0
PRICE_CACHE_TTL_SECONDS=30
COMPUTATION_CACHE_TTL_SECONDS=300
IC_MONITOR_WINDOW=60
IC_DECAY_THRESHOLD=0.05
IC_STABLE_MIN=0.10
IC_TREND_WINDOW=20
SPC_WINDOW_SIZE=60
SPC_SIGMA_THRESHOLD=3.0
SPC_CONSECUTIVE_BREACH_LIMIT=3
WFV_N_SPLITS=10
WFV_TEST_SIZE=126
WFV_GAP=21
WFV_MIN_IC=0.03

# ── Ensemble health gates (advisory; not live order-routing authority) ─
# Batch DN: per-signal weight cap after health/regime gates (empty = disabled)
ENSEMBLE_PER_SIGNAL_WEIGHT_CAP=
# Batch DU: unhealthy arms need IC >= this to soft-floor; weaker IC hard-sleeps
ENSEMBLE_UNHEALTHY_MIN_IC=0.08

# ── Market Data Reconciliation ───────────────────────────────────────
MARKET_DATA_RECON_ADJ_CLOSE_TOLERANCE_PCT=0.5
MARKET_DATA_RECON_MAX_LATEST_LAG_DAYS=1
MARKET_DATA_RECON_MAX_OFFENDERS=5

# ── Research Labs ────────────────────────────────────────────────────
LABS_VALIDATION_MAX_RESULTS=500
LABS_VALIDATION_MAX_ERRORS_PER_RESULT=20
LABS_SCORECARD_POLICY_FILE=

# ── Test Modes ───────────────────────────────────────────────────────
# Safe suite:
#   make test
# TypeScript suite:
#   bun test tests/ts/
# ML suite:
#   PORTFOLIO_LAB_ENABLE_ML=1 make test-ml
# Set automatically by pytest (Batch HP SSOT guards / restamp path guards).
# Do not set in production shells.
PYTEST_CURRENT_TEST=
